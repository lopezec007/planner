# Copy to android/keystore.properties (gitignored) to sign release builds.
# Create the key once with:
#   keytool -genkeypair -v -keystore planner-release.jks -alias planner \
#     -keyalg RSA -keysize 4096 -validity 36500
# and back the .jks up with the rest of your data: losing it means users must
# uninstall and reinstall instead of updating.
storeFile=/path/to/planner-release.jks
storePassword=
keyAlias=planner
keyPassword=
