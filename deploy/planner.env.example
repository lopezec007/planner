# Planner service configuration.
#
# Copy to /etc/planner/planner.env (deploy/install.sh does this on first
# install and never overwrites it afterwards). Lines are KEY=VALUE, read by
# systemd's EnvironmentFile=; after editing run: systemctl restart planner
#
# Everything is commented out below, i.e. the defaults from planner.service
# apply.

# Address to listen on. 0.0.0.0 makes the app reachable from the whole LAN;
# use 127.0.0.1:8080 to restrict it to this machine (e.g. behind a reverse
# proxy). Ports below 1024 need the capability change noted in
# planner.service.
#PLANNER_ADDR=0.0.0.0:8080

# Path to the SQLite database. The default is inside the systemd
# StateDirectory, which is the only writable location under the unit's
# hardening; if you move it elsewhere, add that path to ReadWritePaths= in
# the unit.
#PLANNER_DB=/var/lib/planner/planner.db
